<section class="hero-bonus-panel {{#unless bonusDiceEnabled}}bonus-dice-disabled{{/unless}}">
  <header class="award-header">
    <div>
      <h2>Lex's Variant Rules</h2>
      <p>Opening awards set Hero Points. Break awards add one, capped at 3. Mythic Points retain each character’s system-defined cap.</p>
    </div>
    <div class="award-actions">
      <button type="button" data-action="fill-opening" data-value="1"><i class="fa-solid fa-sun"></i> Fill Selected: 1 Hero Point</button>
      <button type="button" data-action="apply-awards"><i class="fa-solid fa-flag-checkered"></i> Apply Selected Awards</button>
      <button type="button" data-action="award-break"><i class="fa-solid fa-mug-hot"></i> Award Break Hero Point</button>
      {{#if midGameBreakEnabled}}<button type="button" data-action="award-mid-game-break"><i class="fa-solid fa-clock"></i> Apply Mid-Game Break Hero Points</button>{{/if}}
    </div>
  </header>

  <p class="award-hint">Set the MVP’s opening value to <strong>2</strong>, leave the rest at <strong>1</strong>, then apply the selected rows together. Mythic <strong>Set</strong> replaces a character’s current value; Mythic <strong>Add</strong> awards extra points after that value is set.{{#if bonusDiceEnabled}} Choose any bonus dice, or use <strong>Clear</strong> to remove one.{{/if}}</p>

  <div class="award-grid" role="table" aria-label="Party points">
    <div class="award-row award-labels" role="row">
      <span><input type="checkbox" data-action="toggle-all" checked aria-label="Select all party members"></span>
      <span>Character</span><span>Hero Points</span><span>Opening Set</span><span>Mythic Points</span><span>Mythic Set</span><span>Mythic Add</span>{{#if bonusDiceEnabled}}<span>Held Bonus Die</span>{{/if}}
    </div>
    {{#each actors}}
      <div class="award-row" role="row" data-actor-id="{{id}}">
        <span><input type="checkbox" class="award-selected" checked aria-label="Select {{name}}"></span>
        <span class="actor-name"><img src="{{img}}" alt="">{{name}}</span>
        <span class="resource-value">{{hero.value}} / 3</span>
        <span><input class="opening-hero" type="number" min="0" max="3" value="{{hero.value}}" aria-label="Opening Hero Points for {{name}}"></span>
        <span class="resource-value">
          {{#if mythic.enabled}}
            {{mythic.value}} / {{mythic.max}}
          {{else}}
            <em>—</em>
          {{/if}}
        </span>
        <span>
          {{#if mythic.enabled}}
            <input class="mythic-set" type="number" min="0" max="{{mythic.max}}" value="{{mythic.value}}" aria-label="Set Mythic Points for {{name}}">
          {{else}}
            <em>—</em>
          {{/if}}
        </span>
        <span>
          {{#if mythic.enabled}}
            <input class="mythic-add" type="number" min="0" max="3" value="0" aria-label="Add Mythic Points for {{name}}">
          {{else}}
            <em>—</em>
          {{/if}}
        </span>
        {{#if ../bonusDiceEnabled}}
          <span>
            <select class="bonus-die" aria-label="Bonus die for {{name}}">
              {{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </span>
        {{/if}}
      </div>
    {{else}}
      <p>No character members were found in the Party actor.</p>
    {{/each}}
  </div>
</section>
